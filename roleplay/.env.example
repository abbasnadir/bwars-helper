DISCORD_BOT_TOKEN=your_discord_bot_token_here
OWNER_ID=your_discord_user_id_here

# Optional overrides
OLLAMA_URL=http://localhost:11434
# Leave blank to use the first model Ollama reports.
OLLAMA_MODEL=
OLLAMA_TIMEOUT=180
# Simultaneous Ollama requests. 1 keeps the CPU free for Discord; replies always go before memory jobs.
OLLAMA_MAX_CONCURRENCY=1
# Smaller values are faster. 2048-4096 is plenty for short roleplay replies.
OLLAMA_NUM_CTX=4096
# Hard cap on generated tokens. Short replies = fast replies.
OLLAMA_NUM_PREDICT=128
# CPU threads. Leave at the number of physical cores (6 works well on 8-core laptops).
OLLAMA_NUM_THREAD=6
OLLAMA_NUM_BATCH=128
# Keep the model loaded between messages to avoid cold-start delays.
OLLAMA_KEEP_ALIVE=2h
# Optional: use a different model for memory summaries.
OLLAMA_SUMMARY_MODEL=
# Let reasoning models emit hidden "thinking" tokens (usually off for roleplay).
OLLAMA_THINK=false
ROLEPLAY_DB=data/roleplay.db
ROLEPLAY_COMPACT_AFTER=10
# Characters of recent chat sent to the model. Lower = faster.
ROLEPLAY_HISTORY_CHARS=4000
# Replies are capped to this many characters and always fit in one Discord message.
ROLEPLAY_MAX_REPLY_CHARS=1200
# After a message, wait this long for follow-ups so a burst gets one combined reply.
ROLEPLAY_GATHER_SECONDS=1.2
# Never wait longer than this, even if someone keeps typing.
ROLEPLAY_MAX_GATHER_SECONDS=8
# Maximum sentences per reply (0 = no limit).
ROLEPLAY_MAX_SENTENCES=3
# Maximum *italic actions* per reply (0 = speech only).
ROLEPLAY_MAX_ACTIONS=1
# How many automatically learned memory facts to keep per channel.
ROLEPLAY_MEMORY_FACTS=15
# Character budget for memory facts in the prompt.
ROLEPLAY_MEMORY_CHARS=1500
OLLAMA_SUMMARY_PREDICT=400
# auto = sync only when commands change, always = every startup, never = don't sync.
SYNC_COMMANDS=auto
LOG_LEVEL=INFO
